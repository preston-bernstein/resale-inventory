# Copy this file to .env (or .env.local) and fill in real values as needed.
# Nothing here is required to run the app locally with `npm run dev` — every
# variable below is optional and has a safe fallback (see lib/db.ts,
# lib/photos.ts, lib/credentialCrypto.ts, and each connector under
# lib/connectors/ for the exact defaults).

# --- Storage paths (optional overrides; default to ./data/*) --------------
# BOOKSELLER_DB_PATH=./data/inventory.db
# BOOKSELLER_PHOTOS_PATH=./data/photos
# BOOKSELLER_CREDENTIAL_KEY_PATH=./data/credential.key

# A hex-encoded 32-byte (64 hex char) master key for encrypting stored
# marketplace credentials. If unset, a key is generated on first run and
# written to BOOKSELLER_CREDENTIAL_KEY_PATH (0600) — fine for local dev, but
# a real deployment should set this explicitly and keep it out of git.
# BOOKSELLER_CREDENTIAL_KEY=<64 hex characters>

# --- Optional Authentik forward-auth SSO -----------------------------------
# See docs/AUTHENTIK-DEPLOYMENT.md. All three of these must be either set
# together or all left unset — the app fails fast at startup otherwise.
# AUTHENTIK_CLIENT_SECRET=<your Authentik proxy provider's client secret>
# AUTHENTIK_ISSUER=https://auth.example.com/application/o/your-app-slug/
# AUTHENTIK_AUDIENCE=<your Authentik proxy provider's client ID>

# --- Optional: public origin for tailnet/phone-handoff QR codes -----------
# PUBLIC_ORIGIN=https://your-box.your-tailnet.ts.net

# --- Optional: node-exporter textfile-collector metrics export ------------
# NODE_EXPORTER_TEXTFILE_DIR=/path/to/your/node-exporter/textfile-collector-dir

# --- Marketplace connectors (all optional; each connector runs in a safe
# dry-run/sandbox/inert mode until its own credentials are set) ------------

# eBay — real Sandbox environment when both are set
# EBAY_ENV=sandbox
# EBAY_SANDBOX_CLIENT_ID=<your eBay Sandbox client ID>
# EBAY_SANDBOX_CLIENT_SECRET=<your eBay Sandbox client secret>
# EBAY_SANDBOX_REFRESH_TOKEN=<your eBay Sandbox refresh token>

# Etsy — real API, no sandbox; listings are always created in draft state
# ETSY_API_KEY=<your Etsy API key>
# ETSY_SHARED_SECRET=<your Etsy shared secret>

# Amazon — requires a paid Professional Selling Plan + Developer Profile
# AMAZON_LWA_CLIENT_ID=<your Amazon LWA client ID>
# AMAZON_LWA_CLIENT_SECRET=<your Amazon LWA client secret>
# AMAZON_SP_API_REFRESH_TOKEN=<your Amazon SP-API refresh token>

# Poshmark, Depop, Mercari, Vinted, Grailed are Playwright-driven and read
# per-tenant login credentials from the encrypted multi-tenant credential
# system (not environment variables) — see README's "Marketplace Connectors"
# section.
